<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>long_tamp</name>
  <version>0.1.0</version>
  <description>
    Long-TAMP - A generalized manipulation planning framework
    using the PyHPP backend for HPP-based manipulation tasks.
  </description>
  
  <author email="dvtnguyen@laas.fr">Thanh Nguyen</author>
  <maintainer email="dvtnguyen@laas.fr">Thanh Nguyen</maintainer>
  
  <license>LGPL-3.0</license>
  
  <url type="website">https://github.com/thanhndv212/long-tamp</url>
  <url type="repository">https://github.com/thanhndv212/long-tamp</url>
  <url type="bugtracker">https://github.com/thanhndv212/long-tamp/issues</url>
  
  <!-- Build tool dependencies -->
  <buildtool_depend>cmake</buildtool_depend>
  
  <!-- Core dependencies -->
  <depend>pinocchio</depend>
  <depend>hpp-pinocchio</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <!-- Viewer bindings: hpp-gepetto-viewer provides both the Gepetto (Qt)
       viewer AND the pyhpp_viser browser viewer. -->
  <depend condition="$WITH_PYHPP">hpp-gepetto-viewer</depend>

  <!-- PyHPP backend (default) -->
  <depend condition="$WITH_PYHPP">hpp-python</depend>

  <!-- Optional TOPPRA optimizer: pyhpp_toppra ships in hpp-toppra
       (which itself requires the toppra C++ package). -->
  <depend condition="$WITH_TOPPRA">hpp-toppra</depend>

  <!-- Test dependencies -->
  <test_depend>python3-pytest</test_depend>
  
  <export>
    <build_type>cmake</build_type>
  </export>
</package>
