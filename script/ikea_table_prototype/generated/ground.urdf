<?xml version="1.0"?>
<!--
  Plain flat box, matching script/twin/assets/ground_bimanual.urdf's
  pattern — generic primitive, no vendored content. Sized to cover both
  UR10 arms' workspaces (arms 1.5m apart along X, centered at X=0.75) plus
  the table/leg layout, with margin past each arm's ~1.3m reach.
-->
<robot name="ground">
  <link name="ground_base">
    <visual>
      <geometry>
        <box size="3.0 2.0 0.02"/>
      </geometry>
      <origin xyz="0.75 0 -0.01"/>
      <material name="Gray">
        <color rgba="0.6 0.6 0.6 0.6"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="3.0 2.0 0.02"/>
      </geometry>
      <origin xyz="0.75 0 -0.02"/>
    </collision>
  </link>
</robot>
