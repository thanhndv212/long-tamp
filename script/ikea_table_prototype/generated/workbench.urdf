<?xml version="1.0"?>
<!--
  Plain flat box + 4 support legs, same category as ground.urdf/pedestal
  — generic primitive, no vendored content. A static support surface for
  the table/leg parts to rest on. First pass only had the tabletop slab
  (z=0.36 to 0.40) with nothing under it down to the ground — same
  "floating in mid-air" problem one level up. Legs now span z=0 (ground)
  to z=0.36 (underside of the surface), at the 4 corners of the 1.0x0.6m
  footprint, inset 0.05m from each edge.
-->
<robot name="workbench">
  <link name="workbench_base">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.04"/>
      </geometry>
      <origin xyz="0.75 0 0.38"/>
      <material name="Brown">
        <color rgba="0.45 0.32 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 0.6 0.04"/>
      </geometry>
      <origin xyz="0.75 0 0.38"/>
    </collision>

    <visual>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="0.30 -0.25 0.18"/>
      <material name="Brown"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="0.30 -0.25 0.18"/>
    </collision>

    <visual>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="0.30 0.25 0.18"/>
      <material name="Brown"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="0.30 0.25 0.18"/>
    </collision>

    <visual>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="1.20 -0.25 0.18"/>
      <material name="Brown"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="1.20 -0.25 0.18"/>
    </collision>

    <visual>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="1.20 0.25 0.18"/>
      <material name="Brown"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.36"/>
      </geometry>
      <origin xyz="1.20 0.25 0.18"/>
    </collision>
  </link>
</robot>
