<?xml version="1.0"?>
<!--
  Plain box pedestal — generic primitive, no vendored content, same
  category as ground.urdf. 0.3x0.3m footprint, 0.5m tall: UR10 mounted on
  top, matching a typical pedestal-mount installation rather than
  floor-bolted (which is what "arm base at z=0" was implicitly, and
  incorrectly, modeling).
-->
<robot name="pedestal">
  <link name="pedestal_base">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25"/>
      <material name="DarkGray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.5"/>
      </geometry>
      <origin xyz="0 0 0.25"/>
    </collision>
  </link>
</robot>
